Dialogue: 0,0:00:00.00,0:00:10.00,Arial,,0,0,0,,{\an4\fnLT Comical\fscx95\fscy95\bord2.2\shad2.2\blur0.6\3c&H000000&\4c&H000000&\pos(40,520)}{\c&HFF901E&}Çeviri: {\c&HFFFFFF&}Chase, ka4qnn, shxd. {\fscy34.5}\N{\fscy95\c&HFF901E&}Redaksiyon: {\c&HFFFFFF&}ka4qnn{\fscy34.5}\N{\fscy95\c&HFF901E&}Encode: {\c&HFFFFFF&}ka4qnn{\fscy34.5}\N{\fscy95\c&HFF901E&}Upload: {\c&HFFFFFF&}ka4qnn{\fscy34.5}\N{\fscx76.5\fscy76.5\c&HAAAAAA&\b0}discord.gg/luminaceviri{\b1}
Dialogue: 0,0:00:01.67,0:00:04.42,Default,,0,0,0,,Düşünüyorum da acaba...
Dialogue: 0,0:00:04.79,0:00:06.47,Default,,0,0,0,,...ben geleceği değiştirdikten sonra...
Dialogue: 0,0:00:07.38,0:00:11.08,Default,,0,0,0,,...başka biri gelir de tıpkı benim yaptığım gibi onu yine değiştirirse?
Dialogue: 0,0:00:12.80,0:00:15.50,Default,,0,0,0,,Belki Kisaki de benim gibi\Nzamanda sıçrama yapabiliyordur.
Dialogue: 0,0:00:17.39,0:00:19.00,Default,,0,0,0,,Takemitchy…
Dialogue: 0,0:00:19.50,0:00:20.40,Default,,0,0,0,,Efendim?
Dialogue: 0,0:00:21.56,0:00:23.48,Default,,0,0,0,,Mikey'e iyi bak…
Dialogue: 0,0:00:24.57,0:00:26.65,Default,,0,0,0,,...benim için, olur mu?
Dialogue: 0,0:00:31.78,0:00:37.54,Default,,0,0,0,,Sonunda ne Shinichiro'yla ne Emma'yla ne de Mikey'yle bir kan bağım yok.
Dialogue: 0,0:00:38.71,0:00:40.17,Default,,0,0,0,,Hepsi bu kadar, Mikey.
Dialogue: 0,0:00:41.29,0:00:42.38,Default,,0,0,0,,Ne olacak şimdi?
Dialogue: 0,0:00:42.38,0:00:44.09,Default,,0,0,0,,Kurtarmayacak mısın beni?
Dialogue: 0,0:00:49.42,0:00:52.35,Default,,0,0,0,,Kaçamayacaksın ulan! Artık sonun geldi!
Dialogue: 0,0:00:52.35,0:00:55.47,Default,,0,0,0,,Geleceğe geri dönmene izin vermeyeceğim!
Dialogue: 0,0:01:00.60,0:01:03.40,Default,,0,0,0,,"Geleceğe dönmek" mi? Cidden misin sen?
Dialogue: 0,0:01:03.40,0:01:04.52,Default,,0,0,0,,Ha?
Dialogue: 0,0:01:04.52,0:01:09.15,Default,,0,0,0,,Anlaşıldı. Demek zaman yolcusu olduğumu\N düşündüğün için beni durdurmaya çalışıyorsun.
Dialogue: 0,0:01:09.15,0:01:11.11,Default,,0,0,0,,Yani değil misin?
Dialogue: 0,0:01:11.66,0:01:12.74,Default,,0,0,0,,Ben...
Dialogue: 0,0:01:16.29,0:01:17.62,Default,,0,0,0,,Kisaki öldü.
Dialogue: 0,0:01:18.75,0:01:20.87,Default,,0,0,0,,Yani verdiğim mücadele \Nbitmiş olmalıydı, değil mi?
Dialogue: 0,0:01:22.37,0:01:23.58,Default,,0,0,0,,Ama...
Dialogue: 0,0:01:24.08,0:01:28.17,Default,,0,0,0,,...nedense, Kisaki'nin öldüğü günden beri...
Dialogue: 0,0:01:28.17,0:01:31.34,Default,,0,0,0,,...ellerimin titremesi bir türlü geçmiyor.
Dialogue: 0,0:03:01.97,0:03:04.02,Default,,0,0,0,,{\an8}MERHUM EMMA SANO'NUN CENAZESİ
Dialogue: 0,0:03:03.10,0:03:08.82,Default,,0,0,0,,{\an3\fnTimes New Roman\fs90\b0\c&H2A2AA7&\3c&H181818&\4c&H000000&\bord1.2\blur3.5\shad1.5\pos(1816.667,946)}#51 Ayrılık
Dialogue: 0,0:03:05.23,0:03:07.31,Default,,0,0,0,,{\an8}TAZİYE
Dialogue: 0,0:03:30.96,0:03:35.01,Default,,0,0,0,,{\an8}Geldiğiniz için teşekkürler. Bugün, gencecik yaşta kaybettiğimiz kardeşim Emma'yı...
Dialogue: 0,0:03:35.01,0:03:36.30,Default,,0,0,0,,{\an8}...anmak için buradayız.
Dialogue: 0,0:03:37.38,0:03:42.22,Default,,0,0,0,,Emma, 22 Şubat'ta talihsiz bir\N kaza sonucu aramızdan ayrıldı.
Dialogue: 0,0:03:42.22,0:03:45.18,Default,,0,0,0,,Emma'yı hiçbir zaman yalnız bırakmayan...
Dialogue: 0,0:03:45.18,0:03:47.85,Default,,0,0,0,,...ve bugün son görevini yapmak için\Nburaya gelen bütün dostlarıma...
Dialogue: 0,0:03:48.44,0:03:51.02,Default,,0,0,0,,...canıgönülden teşekkür ederim.
Dialogue: 0,0:03:58.57,0:04:01.20,Default,,0,0,0,,Mikey hiç istifini bozmadı bile.
Dialogue: 0,0:04:09.29,0:04:10.29,Default,,0,0,0,,Draken.
Dialogue: 0,0:04:16.01,0:04:17.67,Default,,0,0,0,,Emma'yı canımdan çok seviyordum.
Dialogue: 0,0:04:22.80,0:04:24.26,Default,,0,0,0,,Ne olur affet beni.
Dialogue: 0,0:04:24.77,0:04:27.85,Default,,0,0,0,,Onu koruyamadım…
Dialogue: 0,0:04:35.36,0:04:37.23,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:04:37.24,0:04:39.24,Default,,0,0,0,,Demek sen de çok seviyordun onu.
Dialogue: 0,0:04:42.03,0:04:45.08,Default,,0,0,0,,Eminim şu an bile sevginizi hissediyordur.
Dialogue: 0,0:05:05.64,0:05:09.60,Default,,0,0,0,,{\an8}MERHUM EMMA SANO'NUN CENAZESİ
Dialogue: 0,0:05:20.53,0:05:21.53,Default,,0,0,0,,N'aber?
Dialogue: 0,0:05:25.24,0:05:26.24,Default,,0,0,0,,Koko.
Dialogue: 0,0:05:31.71,0:05:34.08,Default,,0,0,0,,Sanırım artık kendi yoluma gitme vaktim geldi.
Dialogue: 0,0:05:39.05,0:05:41.38,Default,,0,0,0,,Bundan sonra yanında yürümeyeceğim.
Dialogue: 0,0:05:42.00,0:05:44.93,Default,,0,0,0,,O yüzden adımlarına dikkat et\Nve kaybolma, tamam mı?
Dialogue: 0,0:05:47.81,0:05:49.06,Default,,0,0,0,,Kendine iyi bak.
Dialogue: 0,0:05:51.35,0:05:52.48,Default,,0,0,0,,Eyvallah.
Dialogue: 0,0:05:56.27,0:05:58.36,Default,,0,0,0,,Bugüne kadar yaptığın her şey için sağ ol.
Dialogue: 0,0:05:59.61,0:06:00.99,Default,,0,0,0,,Aptal.
Dialogue: 0,0:06:00.99,0:06:02.57,Default,,0,0,0,,Sen de sağ ol.
Dialogue: 0,0:06:15.63,0:06:17.13,Default,,0,0,0,,-Kar yağıyor!\N-Kar yağıyor!
Dialogue: 0,0:06:26.26,0:06:27.89,Default,,0,0,0,,Bayağı derin bir kesik, ha?
Dialogue: 0,0:06:30.47,0:06:32.18,Default,,0,0,0,,Kimin için yapıyorsun bunu?
Dialogue: 0,0:06:35.15,0:06:38.36,Default,,0,0,0,,Huzur içinde uyu, Izana. Elveda.
Dialogue: 0,0:06:54.16,0:06:58.48,Default,,0,0,0,,Emma Sano ve Izana Kurokawa'nın \Nölümleri resmî kayıtlara cinayet olarak geçti.
Dialogue: 0,0:06:59.18,0:07:05.13,Default,,0,0,0,,Asıl fail Kisaki Tetta, yardım ve yataklık eden ise Hanma Shuji'ydi.
Dialogue: 0,0:07:26.57,0:07:29.03,Default,,0,0,0,,Hadi canım, bir olay daha mı?
Dialogue: 0,0:07:29.03,0:07:31.99,Default,,0,0,0,,Dünya günden güne daha \Ntehlikeli bir yer olmaya başladı.
Dialogue: 0,0:07:31.99,0:07:34.41,Default,,0,0,0,,-Hesap lütfen!\N-Hemen geliyorum.
Dialogue: 0,0:07:35.50,0:07:38.85,Default,,0,0,0,,Güldürmeyin adamı. Dünyayı heyecanlı kılan da bu tehlike zaten.
Dialogue: 0,0:07:39.38,0:07:41.00,Default,,0,0,0,,Eline sağlık, usta!
Dialogue: 0,0:07:46.93,0:07:49.30,Default,,0,0,0,,Böyle kaçak dövüşmek de acayip sıkıcı be.
Dialogue: 0,0:07:52.26,0:07:55.93,Default,,0,0,0,,Hanma Shuji hâlâ firari olarak aranıyor.
Dialogue: 0,0:08:06.36,0:08:08.41,Default,,0,0,0,,Tamamdır, kararımı verdim.
Dialogue: 0,0:08:12.45,0:08:14.16,Default,,0,0,0,,Bir, iki, üç, dört,
Dialogue: 0,0:08:14.16,0:08:17.20,Default,,0,0,0,,beş, altı, yedi, sekiz, \Ndokuz, on, on bir, on iki…
Dialogue: 0,0:08:17.21,0:08:20.04,Default,,0,0,0,,Gördün mü Takemitchy? \NYeni rekor kırdım.
Dialogue: 0,0:08:21.25,0:08:23.25,Default,,0,0,0,,Hmm, iyiymiş.
Dialogue: 0,0:08:27.88,0:08:29.05,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:08:31.18,0:08:33.62,Default,,0,0,0,,Bak dostum, ne hissettiğini anlıyorum.
Dialogue: 0,0:08:33.98,0:08:37.85,Default,,0,0,0,,Artık Emma gittiğine göre ve \NIzana da aradan çekildiğine göre...
Dialogue: 0,0:08:37.85,0:08:39.48,Default,,0,0,0,,-...sana hak veriyorum.\N-Mesele o değil.
Dialogue: 0,0:08:40.60,0:08:44.34,Default,,0,0,0,,Sadece… Kisaki'nin aslında kim olduğunu düşünüp duruyorum.
Dialogue: 0,0:08:47.90,0:08:50.34,Default,,0,0,0,,Mesele şu ki, her şeyi yanlış anlamışım.
Dialogue: 0,0:08:50.82,0:08:53.57,Default,,0,0,0,,Sonuçta Kisaki zaman yolcusu falan değilmiş.
Dialogue: 0,0:08:53.58,0:08:56.33,Default,,0,0,0,,-Ne?\N-Sadece tek bir hayatta,
Dialogue: 0,0:08:56.33,0:08:58.96,Default,,0,0,0,,Toman liderlerini parmağında oynatmayı...
Dialogue: 0,0:08:59.46,0:09:01.08,Default,,0,0,0,,...önüne çıkanı haklamayı...
Dialogue: 0,0:09:01.58,0:09:04.46,Default,,0,0,0,,...ve Japonya'nın en büyük çetelerinin basamaklarını tek başına tırmanmayı başardı.
Dialogue: 0,0:09:06.00,0:09:09.55,Default,,0,0,0,,Tüm bunları başarmak için kim \Nbilir kaç gece uykusuz kaldı?
Dialogue: 0,0:09:11.22,0:09:14.35,Default,,0,0,0,,Dövüş konusunda iyi olmadığı ortadaydı.
Dialogue: 0,0:09:15.14,0:09:17.68,Default,,0,0,0,,Zirveye tırmanmak için sadece zekâsını kullandı.
Dialogue: 0,0:09:18.31,0:09:19.68,Default,,0,0,0,,Buna saygı duymak zorundayım.
Dialogue: 0,0:09:19.68,0:09:22.02,Default,,0,0,0,,Ne saçmalıyorsun lan sen?
Dialogue: 0,0:09:22.02,0:09:24.90,Default,,0,0,0,,Kisaki'nin zirveye nasıl çıktığı kimin umurunda?
Dialogue: 0,0:09:24.90,0:09:26.32,Default,,0,0,0,,Şerefsizin tekiydi işte!
Dialogue: 0,0:09:27.03,0:09:29.78,Default,,0,0,0,,Neden kafanı yoruyorsun ki öyle biri için?
Dialogue: 0,0:09:29.78,0:09:31.78,Default,,0,0,0,,O pislik gebermeyi hak etti.
Dialogue: 0,0:09:32.36,0:09:34.07,Default,,0,0,0,,Ben sadece şey diyorum...
Dialogue: 0,0:09:38.04,0:09:40.00,Default,,0,0,0,,Hey! Takemitchy!
Dialogue: 0,0:09:42.67,0:09:43.83,Default,,0,0,0,,Takemitchy!
Dialogue: 0,0:09:51.17,0:09:53.22,Default,,0,0,0,,Neden böyle bir şey yaptın lan aptal?
Dialogue: 0,0:09:53.22,0:09:55.09,Default,,0,0,0,,-Chifuyu!\N-Ha?
Dialogue: 0,0:09:55.30,0:09:58.85,Default,,0,0,0,,İnan bana, ben de en az senin kadar nefret ediyorum o piçten.
Dialogue: 0,0:09:58.85,0:10:00.77,Default,,0,0,0,,Bize çektirdiği onca boktan nefret ediyorum!
Dialogue: 0,0:10:03.90,0:10:06.98,Default,,0,0,0,,Ve bize yaptıklarını asla \Nama asla affetmeyeceğim!
Dialogue: 0,0:10:12.40,0:10:16.32,Default,,0,0,0,,Ama öldüğü gün, her şeyi \NHina için yaptığını söyledi!
Dialogue: 0,0:10:16.91,0:10:19.29,Default,,0,0,0,,Hatta bana saygı duyduğunu bile söyledi!
Dialogue: 0,0:10:21.04,0:10:23.33,Default,,0,0,0,,Bilmiyordum. Bu yüzden…
Dialogue: 0,0:10:24.50,0:10:27.88,Default,,0,0,0,,Keşke onunla son bir kez \Ndüzgünce konuşabilseydik!
Dialogue: 0,0:10:29.92,0:10:31.13,Default,,0,0,0,,Hay sokayım!
Dialogue: 0,0:10:34.09,0:10:36.64,Default,,0,0,0,,Orada durmaya devam edersen\N hastalanacaksın, Takemitchy.
Dialogue: 0,0:10:38.56,0:10:41.43,Default,,0,0,0,,Şimdi nasıl hissediyorsun? Daha iyi mi?
Dialogue: 0,0:10:42.64,0:10:46.35,Default,,0,0,0,,Bilmiyorum. Onun ölümü\Nbana hiç doğru gelmiyor.
Dialogue: 0,0:10:46.35,0:10:48.98,Default,,0,0,0,,Doğru, biliyorum.
Dialogue: 0,0:10:55.22,0:10:57.24,Default,,0,0,0,,Ne kadar kötü biri olursa olsun...
Dialogue: 0,0:10:57.90,0:11:01.10,Default,,0,0,0,,...birini kaybetmek kolay değil.
Dialogue: 0,0:11:02.12,0:11:05.20,Default,,0,0,0,,Beni takdir ettiğini söyledi.
Dialogue: 0,0:11:05.72,0:11:08.83,Default,,0,0,0,,Öyle söylediğini duydum.
Dialogue: 0,0:11:08.84,0:11:13.80,Default,,0,0,0,,Anlayamıyorum. Neden benim\N gibi birini takdir etsin ki?
Dialogue: 0,0:11:13.80,0:11:16.63,Default,,0,0,0,,Hmm, görünce anlıyormuş.
Dialogue: 0,0:11:16.63,0:11:17.64,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:18.55,0:11:19.76,Default,,0,0,0,,Yok bir şey.
Dialogue: 0,0:11:31.23,0:11:33.07,Default,,0,0,0,,MUSASHI MABEDİ
Dialogue: 0,0:11:35.24,0:11:36.53,Default,,0,0,0,,Hey, Mikey.
Dialogue: 0,0:11:36.53,0:11:38.45,Default,,0,0,0,,Bu saatte çağırdığım için üzgünüm.
Dialogue: 0,0:11:39.37,0:11:41.16,Default,,0,0,0,,Seninle konuşmak istedim.
Dialogue: 0,0:11:41.99,0:11:43.83,Default,,0,0,0,,Sana bir şey sormam gerek.
Dialogue: 0,0:11:45.54,0:11:49.29,Default,,0,0,0,,Biliyorum gelecekten geliyorsun ama… bana her şeyin nasıl başladığını anlatır mısın?
Dialogue: 0,0:11:52.38,0:11:53.38,Default,,0,0,0,,Tabii.
Dialogue: 0,0:11:55.05,0:12:00.05,Default,,0,0,0,,Kendi zamanımda, 26 yaşındaydım,\Ngeçinmek için yarı zamanlı işlerde çalışıyordum.
Dialogue: 0,0:12:01.01,0:12:03.97,Default,,0,0,0,,Ne yaparsam yapayım başarılı olamadım.
Dialogue: 0,0:12:03.97,0:12:08.48,Default,,0,0,0,,Doğruyu söylemek gerekirse\Nkafaya takmamaya başladım.
Dialogue: 0,0:12:08.48,0:12:13.32,Default,,0,0,0,,Bir gün gelecekteki haberlerde Toman'ın karıştığı bir Yakuza çatışmasını duydum.
Dialogue: 0,0:12:13.32,0:12:15.78,Default,,0,0,0,,Ve Hina'nın da bütün \Nbunların ortasında öldüğünü.
Dialogue: 0,0:12:16.57,0:12:21.11,Default,,0,0,0,,O güne kadar onu neredeyse unutmuştum. Zaten hiçbir işe yaramayan bir eziktim.
Dialogue: 0,0:12:21.12,0:12:23.49,Default,,0,0,0,,O benim sahip olduğum tek kız arkadaştı.
Dialogue: 0,0:12:24.91,0:12:31.54,Default,,0,0,0,,Sonra, 4 Temmuz 2017'de biri \Nbeni tren raylarının üzerine itti.
Dialogue: 0,0:12:32.34,0:12:35.13,Default,,0,0,0,,Bunun sonum olduğunu \Nsanmıştım ama öyle değildi.
Dialogue: 0,0:12:35.13,0:12:37.42,Default,,0,0,0,,2005'e geri gelmiştim.
Dialogue: 0,0:12:38.47,0:12:40.93,Default,,0,0,0,,O gün, Mizo okulundan\N arkadaşlarımla birlikte...
Dialogue: 0,0:12:40.93,0:12:43.39,Default,,0,0,0,,Kiyomasa ve çetesi tarafından\N dayak yediğimiz gündü.
Dialogue: 0,0:12:43.39,0:12:46.60,Default,,0,0,0,,Aynı zamanda onun adamı \Nolmaya zorlandığımız gün.
Dialogue: 0,0:12:47.14,0:12:50.73,Default,,0,0,0,,İlk başta, hayatımın gözlerimin \Nönünden akıp gittiğini sandım.
Dialogue: 0,0:12:51.94,0:12:53.98,Default,,0,0,0,,Ama bir şekilde, bir şeylerin \Nfarklı olduğunu biliyordum.
Dialogue: 0,0:12:57.36,0:13:02.41,Default,,0,0,0,,Sonra Hina'yla karşılaştım ve onun öylece ölmesine izin veremeyeceğimi düşündüm.
Dialogue: 0,0:13:04.28,0:13:05.99,Default,,0,0,0,,İşte her şey böyle başladı.
Dialogue: 0,0:13:09.21,0:13:11.29,Default,,0,0,0,,Ne kadar zamandır konuşuyoruz?
Dialogue: 0,0:13:11.29,0:13:14.84,Default,,0,0,0,,Mikey yanımda oturmuş, anlattığım her şeyi sessizce dinliyordu.
Dialogue: 0,0:13:15.75,0:13:17.67,Default,,0,0,0,,Sanırım içimi dökmeme izin veriyordu.
Dialogue: 0,0:13:18.72,0:13:23.39,Default,,0,0,0,,Kelimeler ağzımdan döküldükçe, yaşanan her şeyi yeniden hatırlamaya başladım.
Dialogue: 0,0:13:23.39,0:13:25.35,Default,,0,0,0,,Ve yeniden duygulanmaya başladım.
Dialogue: 0,0:13:29.39,0:13:31.89,Default,,0,0,0,,Özür dilerim, Mikey-kun…
Dialogue: 0,0:13:32.40,0:13:35.52,Default,,0,0,0,,Emma ve Baji'yi kurtaramadım.
Dialogue: 0,0:13:36.32,0:13:38.36,Default,,0,0,0,,Benim yüzümden öldüler!
Dialogue: 0,0:13:41.57,0:13:42.99,Default,,0,0,0,,Çok üzgünüm.
Dialogue: 0,0:13:43.74,0:13:44.78,Default,,0,0,0,,Üzgünüm...
Dialogue: 0,0:13:45.83,0:13:49.08,Default,,0,0,0,,Lütfen beni affet, Mikey!
Dialogue: 0,0:13:55.21,0:13:56.92,Default,,0,0,0,,Senin farklı olduğunu biliyordum.
Dialogue: 0,0:13:56.92,0:13:58.30,Default,,0,0,0,,Ha?
Dialogue: 0,0:13:59.38,0:14:01.34,Default,,0,0,0,,Seni okulda ilk gördüğümde,
Dialogue: 0,0:14:01.34,0:14:05.26,Default,,0,0,0,,Kiyomasa, yeraltı dövüşlerinden birinde seni fena hâlde dövüyordu.
Dialogue: 0,0:14:05.89,0:14:09.97,Default,,0,0,0,,Ama seni ne kadar yere sererse sersin, sen her seferinde ayağa kalkıyordun.
Dialogue: 0,0:14:09.97,0:14:13.31,Default,,0,0,0,,Dünyanın tüm yükünü omuzlarında taşıyabilecek biri olduğunu düşündüm.
Dialogue: 0,0:14:13.94,0:14:17.19,Default,,0,0,0,,Yani sen… gerçekten ortaokulda mısın?
Dialogue: 0,0:14:18.86,0:14:20.44,Default,,0,0,0,,Sonuçta hiç değişmemişsin.
Dialogue: 0,0:14:22.74,0:14:25.11,Default,,0,0,0,,Sana hayranlık duyuyorum, Takemitchy.
Dialogue: 0,0:14:31.41,0:14:33.46,Default,,0,0,0,,İLK NESLİN LİDERİ
Dialogue: 0,0:14:33.46,0:14:36.42,Default,,0,0,0,,{\an8}Ben hep yeni çağı başlatacak\Nkişi olduğumu düşünmüştüm ama...
Dialogue: 0,0:14:40.46,0:14:42.26,Default,,0,0,0,,Ayağa kalk, Takemitchy.
Dialogue: 0,0:14:43.42,0:14:44.88,Default,,0,0,0,,Bunu duyabiliyor musun?
Dialogue: 0,0:14:44.88,0:14:46.26,Default,,0,0,0,,TOKYO MANJI ÇETESİ
Dialogue: 0,0:14:46.84,0:14:48.43,Default,,0,0,0,,Değişimin ayak sesleri.
Dialogue: 0,0:14:50.77,0:14:53.14,Default,,0,0,0,,Herkesi kurtarmak için...
Dialogue: 0,0:14:53.14,0:14:56.02,Default,,0,0,0,,Kaç kez yenilirse yenilsin \Nayağa kalkmış olan sen...
Dialogue: 0,0:14:57.06,0:14:59.69,Default,,0,0,0,,Bugün bu çağı kurtardın.
Dialogue: 0,0:15:11.70,0:15:13.66,Default,,0,0,0,,Senin çağın.
Dialogue: 0,0:15:18.67,0:15:20.80,Default,,0,0,0,,Bu yüzden karar verdim.
Dialogue: 0,0:15:22.21,0:15:23.42,Default,,0,0,0,,Dinleyin beyler!
Dialogue: 0,0:15:24.09,0:15:27.43,Default,,0,0,0,,Büyük kayıplar verdik ama Tenjiku'yu ezdik!
Dialogue: 0,0:15:27.43,0:15:29.85,Default,,0,0,0,,Ve Toman onların külleri sayesinde yükseldi.
Dialogue: 0,0:15:29.85,0:15:34.10,Default,,0,0,0,,Sizin sayenizde, zirvede \Nolduğumuz yeni bir çağa giriyoruz.
Dialogue: 0,0:15:35.31,0:15:38.98,Default,,0,0,0,,Tam da bir şeylere son vermenin zamanı.
Dialogue: 0,0:15:40.02,0:15:41.02,Default,,0,0,0,,Ha?
Dialogue: 0,0:15:41.57,0:15:46.07,Default,,0,0,0,,Bugünden itibaren Tokyo Manji Çetesi dağılmıştır!
Dialogue: 0,0:15:49.70,0:15:53.37,Default,,0,0,0,,Bugünden itibaren Tokyo Manji Çetesi dağılmıştır!
Dialogue: 0,0:15:54.83,0:15:56.54,Default,,0,0,0,,-Ne?\N-Dağıldı mı?
Dialogue: 0,0:15:56.54,0:15:59.50,Default,,0,0,0,,Mikey, ne demek istiyorsun?
Dialogue: 0,0:15:59.50,0:16:01.63,Default,,0,0,0,,Cidden mi? Ne düşünüyorsun sen?
Dialogue: 0,0:16:01.63,0:16:03.34,Default,,0,0,0,,Cidden dağıldı mı dedi?
Dialogue: 0,0:16:03.34,0:16:05.88,Default,,0,0,0,,-Bu olamaz.\N-Bu Toman'ın sonu olamaz.
Dialogue: 0,0:16:07.34,0:16:11.05,Default,,0,0,0,,Birinci Bölük Kaptanı Takemichi Hanagaki, öne çık!
Dialogue: 0,0:16:11.05,0:16:14.26,Default,,0,0,0,,-Neden dağılalım ki?\N-Bu kadar ilerlemişken?
Dialogue: 0,0:16:14.27,0:16:17.31,Default,,0,0,0,,Eğer geleceği değiştirmek \Nistiyorsak, bu en iyi yolu değil mi?
Dialogue: 0,0:16:17.31,0:16:19.48,Default,,0,0,0,,Mikey-kun, bekle biraz.
Dialogue: 0,0:16:19.48,0:16:23.06,Default,,0,0,0,,İkinci Bölük Kaptanı Takashi Mitsuya, öne çık!
Dialogue: 0,0:16:28.86,0:16:29.86,Default,,0,0,0,,Mikey.
Dialogue: 0,0:16:30.53,0:16:33.74,Default,,0,0,0,,Emeklerin için teşekkürler.\NSenin sayende bu kadar ilerledik.
Dialogue: 0,0:16:33.74,0:16:36.20,Default,,0,0,0,,Bekle. Bir dakika bekle, Mikey.
Dialogue: 0,0:16:36.20,0:16:39.46,Default,,0,0,0,,Üçüncü Bölük Kaptanı, Ryohei Hayashi!
Dialogue: 0,0:16:41.00,0:16:43.96,Default,,0,0,0,,Pah-chin hapse girdiğinde, \Ngörevini layıkıyla yerine getirdin.
Dialogue: 0,0:16:44.59,0:16:47.17,Default,,0,0,0,,Bizi gururlandırdın, yardımcı kaptan.
Dialogue: 0,0:16:47.17,0:16:48.42,Default,,0,0,0,,Mikey.
Dialogue: 0,0:16:48.42,0:16:51.43,Default,,0,0,0,,Dördüncü Bölük Kaptanı, Nahoya Kawata!
Dialogue: 0,0:16:53.01,0:16:56.60,Default,,0,0,0,,Toman'ı bu kadar desteklediğin \Niçin teşekkür ederim, Smiley.
Dialogue: 0,0:16:56.60,0:16:59.14,Default,,0,0,0,,Cidden, böyle konuşmayı bırak artık.
Dialogue: 0,0:16:59.73,0:17:01.56,Default,,0,0,0,,Mikey, bunu istemiyorum.
Dialogue: 0,0:17:01.56,0:17:04.52,Default,,0,0,0,,Beşinci Bölük Kaptanı, Yasuhiro Muto!
Dialogue: 0,0:17:04.52,0:17:07.15,Default,,0,0,0,,Şu an parmaklıklar ardında olsa bile,
Dialogue: 0,0:17:07.15,0:17:09.90,Default,,0,0,0,,o her zaman Toman'ın mirasının vazgeçilmez bir parçası olacak!
Dialogue: 0,0:17:11.24,0:17:17.04,Default,,0,0,0,,Ve son olarak, Tokyo Manji Çetesi'nin Başkan Yardımcısı Ken Ryuguji.
Dialogue: 0,0:17:23.04,0:17:27.30,Default,,0,0,0,,Manjiro Sano, bencil herifin tekisin.
Dialogue: 0,0:17:27.30,0:17:30.09,Default,,0,0,0,,Sanki dünya sadece senin etrafında\Ndönüyormuş gibi davranıyorsun hep.
Dialogue: 0,0:17:30.97,0:17:35.89,Default,,0,0,0,,Ama işte bizi kendine çeken ve sonuna kadar\Npeşinden sürükleyen de bu karizmandı.
Dialogue: 0,0:17:36.64,0:17:39.56,Default,,0,0,0,,Liderimizin kararına hiçbir itirazım yok.
Dialogue: 0,0:17:40.64,0:17:44.90,Default,,0,0,0,,Bizim için yaptığın her şey için\Nteşekkür ederiz, Kaptan!
Dialogue: 0,0:17:58.91,0:18:00.71,Default,,0,0,0,,Sağ ol, Ken-chin.
Dialogue: 0,0:18:01.29,0:18:02.75,Default,,0,0,0,,Toman!
Dialogue: 0,0:18:02.75,0:18:09.25,Default,,0,0,0,,Toman! Toman! Toman! Toman!
Dialogue: 0,0:18:09.26,0:18:12.09,Default,,0,0,0,,Bugün Toman dağılıyor olabilir ama...
Dialogue: 0,0:18:12.09,0:18:15.51,Default,,0,0,0,,...o ruh hepimizin içinde \Nsonsuza dek yaşayacak!
Dialogue: 0,0:18:15.51,0:18:17.01,Default,,0,0,0,,Bu yüzden başınızı dik tutun!
Dialogue: 0,0:18:17.60,0:18:19.06,Default,,0,0,0,,Sakın unutmayın,
Dialogue: 0,0:18:19.06,0:18:22.35,Default,,0,0,0,,{\an8}Toman'ın ateşi kalbinizde daima yanacak!
Dialogue: 0,0:18:27.48,0:18:30.94,Default,,0,0,0,,BİR HAFTA SONRA, 15 MART 2006
Dialogue: 0,0:18:38.03,0:18:39.62,Default,,0,0,0,,Bu kadarı iş görür.
Dialogue: 0,0:18:51.46,0:18:53.38,Default,,0,0,0,,Kabullenmek hâlâ çok zor be abi.
Dialogue: 0,0:18:54.68,0:18:57.72,Default,,0,0,0,,Cidden dağılıyor muyuz yani?
Dialogue: 0,0:18:57.72,0:18:59.26,Default,,0,0,0,,Evet, sanırım öyle.
Dialogue: 0,0:18:59.81,0:19:03.77,Default,,0,0,0,,Ama yani, Mikey'nin yerinde ben olsaydım\N ben de aynısını yapardım herhâlde.
Dialogue: 0,0:19:03.77,0:19:07.94,Default,,0,0,0,,Çünkü düşününce, aramızda\N en çok şey kaybeden o oldu.
Dialogue: 0,0:19:09.69,0:19:11.19,Default,,0,0,0,,-Takemitchy?\N-Hı?
Dialogue: 0,0:19:11.78,0:19:14.11,Default,,0,0,0,,Artık Toman dağıldığına göre, planın ne?
Dialogue: 0,0:19:14.11,0:19:15.45,Default,,0,0,0,,Derken?
Dialogue: 0,0:19:15.45,0:19:18.78,Default,,0,0,0,,Yani Toman dağıldığına ve \NKisaki de aradan çekildiğine göre...
Dialogue: 0,0:19:19.28,0:19:21.83,Default,,0,0,0,,geçmişte kalman için bir\N neden kalmadı, değil mi?
Dialogue: 0,0:19:21.83,0:19:23.87,Default,,0,0,0,,Artık Kisaki öldüğüne göre,
Dialogue: 0,0:19:23.87,0:19:26.58,Default,,0,0,0,,gelecekte Naoto'yu öldürmesi de imkânsız.
Dialogue: 0,0:19:28.88,0:19:33.00,Default,,0,0,0,,Ve Naoto hayatta olduğuna göre, tekrar zamanda sıçrayabiliyor olmalıyım.
Dialogue: 0,0:19:33.01,0:19:34.46,Default,,0,0,0,,Hmm.
Dialogue: 0,0:19:34.47,0:19:37.51,Default,,0,0,0,,Bu kez geri döndüğümde\Nher şey çok güzel olacak.
Dialogue: 0,0:19:39.43,0:19:41.39,Default,,0,0,0,,Hı? N'oldu?
Dialogue: 0,0:19:41.39,0:19:45.89,Default,,0,0,0,,O kadar olay yaşandı ki buradaki \Nherkes kardeşim gibi oldu artık.
Dialogue: 0,0:19:46.85,0:19:47.94,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:19:47.94,0:19:51.40,Default,,0,0,0,,Veda etmek öyle zor ki be abi.
Dialogue: 0,0:19:51.40,0:19:52.82,Default,,0,0,0,,Takemitchy.
Dialogue: 0,0:19:53.86,0:19:55.74,Default,,0,0,0,,Herkesi gerçekten çok özleyeceğim.
Dialogue: 0,0:19:57.78,0:19:59.70,Default,,0,0,0,,-Millet!\N-Ha?
Dialogue: 0,0:19:59.70,0:20:02.78,Default,,0,0,0,,Toman'ın anısına bir zaman kapsülü gömelim.
Dialogue: 0,0:20:02.79,0:20:05.16,Default,,0,0,0,,-O ne be?\N-Zaman kapsülü de nereden çıktı?
Dialogue: 0,0:20:05.16,0:20:06.25,Default,,0,0,0,,Niye ki?
Dialogue: 0,0:20:06.25,0:20:07.46,Default,,0,0,0,,Bence iyi fikir.
Dialogue: 0,0:20:08.67,0:20:09.79,Default,,0,0,0,,Ne yapsak…
Dialogue: 0,0:20:11.29,0:20:13.46,Default,,0,0,0,,Gelecekteki kendimize mektup yazmalıyız.
Dialogue: 0,0:20:13.46,0:20:14.80,Default,,0,0,0,,Mektup mu?
Dialogue: 0,0:20:14.80,0:20:17.34,Default,,0,0,0,,Hımm… Ne kadar bekleyeceğiz peki?
Dialogue: 0,0:20:19.18,0:20:20.68,Default,,0,0,0,,12 yıl sonra açsak nasıl olur?
Dialogue: 0,0:20:21.47,0:20:22.68,Default,,0,0,0,,Bayağı da varmış.
Dialogue: 0,0:20:26.39,0:20:28.31,Default,,0,0,0,,Niye 12 yıl peki?
Dialogue: 0,0:20:28.31,0:20:30.40,Default,,0,0,0,,Hiçbir fikrim yok. Ama her türlü varım.
Dialogue: 0,0:20:31.69,0:20:33.52,Default,,0,0,0,,Bir hafta sonra yine burada buluşalım.
Dialogue: 0,0:20:33.52,0:20:35.69,Default,,0,0,0,,Mektubu ve sizin için \Ndeğerli olan bir şeyi getirin.
Dialogue: 0,0:20:35.69,0:20:36.74,Default,,0,0,0,,Anlaştık mı?
Dialogue: 0,0:20:38.65,0:20:40.20,Default,,0,0,0,,Ee, ne gömdün?
Dialogue: 0,0:20:40.20,0:20:43.16,Default,,0,0,0,,Söylersem bütün eğlencesi kaçar, aptal.
Dialogue: 0,0:20:43.16,0:20:45.95,Default,,0,0,0,,On iki yıl, ha? Çok var daha.
Dialogue: 0,0:20:45.95,0:20:47.95,Default,,0,0,0,,Bugün buraya ne gömdüğümüzü\Nkesin unuturuz biz ya.
Dialogue: 0,0:20:47.96,0:20:51.33,Default,,0,0,0,,Aynen öyle. Zaman kapsülünün \Nen güzel olayı da bu ya.
Dialogue: 0,0:20:51.33,0:20:54.09,Default,,0,0,0,,-O zaman daha önce de yaptın bunu.\N-Yoo.
Dialogue: 0,0:20:54.09,0:20:56.30,Default,,0,0,0,,-Aslında biraz heyecan verici.\N-Evet.
Dialogue: 0,0:20:56.30,0:20:58.38,Default,,0,0,0,,En azından dört gözle\Nbekleyeceğimiz bir şey var.
Dialogue: 0,0:21:00.97,0:21:02.85,Default,,0,0,0,,Takvimlerinize işaretleyin.
Dialogue: 0,0:21:03.43,0:21:07.60,Default,,0,0,0,,Bundan 12 yıl sonra, 19 Haziran'da,\N Toman'ın kuruluş gününde,
Dialogue: 0,0:21:07.60,0:21:09.31,Default,,0,0,0,,hepinizi yine burada görmek istiyorum.
Dialogue: 0,0:21:15.19,0:21:18.32,Default,,0,0,0,,Abi, beni böyle uğurlamaya gelmeniz\Ngerçekten dünyalara bedel valla.
Dialogue: 0,0:21:20.36,0:21:22.74,Default,,0,0,0,,Kendine iyi bak, Takemitchy.
Dialogue: 0,0:21:22.74,0:21:23.82,Default,,0,0,0,,Ha?
Dialogue: 0,0:21:23.82,0:21:27.70,Default,,0,0,0,,Mesele şu ki, herkesin\Nait olduğu bir yer vardır.
Dialogue: 0,0:21:29.00,0:21:30.66,Default,,0,0,0,,Ve senin yerin burası değil, değil mi?
Dialogue: 0,0:21:30.66,0:21:31.67,Default,,0,0,0,,Hı?
Dialogue: 0,0:21:33.17,0:21:34.25,Default,,0,0,0,,Biliyorum, fakat--
Dialogue: 0,0:21:34.25,0:21:37.51,Default,,0,0,0,,Takemitchy, için rahat olsun.
Dialogue: 0,0:21:38.26,0:21:40.26,Default,,0,0,0,,Tekrar karşılaşacağımız güne kadar,
Dialogue: 0,0:21:40.76,0:21:44.35,Default,,0,0,0,,Toman'daki herkesi ve Hina'yı\N koruyacağıma söz veriyorum.
Dialogue: 0,0:21:47.06,0:21:48.35,Default,,0,0,0,,Ne pahasına olursa olsun.
Dialogue: 0,0:21:49.39,0:21:51.27,Default,,0,0,0,,Ağlatacaksın beni, Mikey.
Dialogue: 0,0:21:51.89,0:21:54.94,Default,,0,0,0,,Neden ki? Vedalaşmanın \Nzor olduğunu biliyorum.
Dialogue: 0,0:21:55.52,0:21:57.53,Default,,0,0,0,,Artık eve dönme zamanın geldi, Takemitchy.
Dialogue: 0,0:21:58.61,0:22:01.90,Default,,0,0,0,,Hina zaten yeterince uzun \Nzamandır dönmeni bekliyordu.
Dialogue: 0,0:22:01.90,0:22:02.91,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:23:40.92,0:23:42.59,Default,,0,0,0,,{\an8}MASAL İNTİKAMCILARI - MİNİ\N#1 "MOMOTARO'NUN DÖNÜŞÜ"
Dialogue: 0,0:23:42.06,0:23:43.67,Default,,0,0,0,,-Masal İntikamcıları.\N-Masal İntikamcıları.
Dialogue: 0,0:23:43.67,0:23:46.01,Default,,0,0,0,,İşte söz verdiğim kaburga kasesi.
Dialogue: 0,0:23:46.01,0:23:47.93,Default,,0,0,0,,Off, müthiş gözüküyor.
Dialogue: 0,0:23:47.93,0:23:50.43,Default,,0,0,0,,Yolculuktan sonra verilecek\Nen mükemmel ödül bu.
Dialogue: 0,0:23:53.18,0:23:56.23,Default,,0,0,0,,Umarım yakında yeni maceralara atılabiliriz.
Dialogue: 0,0:23:56.23,0:23:58.39,Default,,0,0,0,,-Kokla, kokla.\N-Kokla, kokla.
Dialogue: 0,0:23:58.40,0:24:01.27,Default,,0,0,0,,Ooo, mis gibi kokuyor Mikey!
Dialogue: 0,0:24:01.27,0:24:03.07,Default,,0,0,0,,Yer misiniz?
Dialogue: 0,0:24:03.07,0:24:04.65,Default,,0,0,0,,Madem teklif ediyorsun, olur.
Dialogue: 0,0:24:04.65,0:24:06.74,Default,,0,0,0,,-Teşekkürler, Mikey!\N-La?
Dialogue: 0,0:24:07.24,0:24:10.53,Default,,0,0,0,,Yavaş ol biraz.\NDiğerlerine de bir şeyler bırak.
Dialogue: 0,0:24:10.53,0:24:12.83,Default,,0,0,0,,Ama daha sadece bir tane yedim.
Dialogue: 0,0:24:12.83,0:24:14.79,Default,,0,0,0,,Ha?
Dialogue: 0,0:24:14.79,0:24:16.12,Default,,0,0,0,,Lan, geldiler!
Dialogue: 0,0:24:16.87,0:24:18.00,Default,,0,0,0,,Ne zaman akıllanacaklar?
Dialogue: 0,0:24:18.00,0:24:20.88,Default,,0,0,0,,Benim kaburga kaseme\Nnasıl bulaşırsınız ulan!
Dialogue: 0,0:24:20.88,0:24:22.50,Default,,0,0,0,,-Eyvah.\N-Kaçma lan!
Dialogue: 0,0:24:22.50,0:24:24.75,Default,,0,0,0,,{\an8}Dur!\NSeni geberteceğim!
Dialogue: 0,0:24:24.76,0:24:26.84,Default,,0,0,0,,{\an8\fnArial\b1\c&HFFFFFF&\3c&H3361E6&\bord9\shad0\pos(1610,824)}DEVAM EDECEK
