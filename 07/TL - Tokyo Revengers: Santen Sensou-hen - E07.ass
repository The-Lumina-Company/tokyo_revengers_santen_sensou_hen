Dialogue: 0,0:00:03.96,0:00:05.13,Default,,0,0,0,,Senju!
Dialogue: 0,0:00:07.42,0:00:08.93,Default,,0,0,0,,Hanagaki...
Dialogue: 0,0:00:11.01,0:00:14.01,Default,,0,0,0,,Gördün mü? Dilediğim şey gerçek oldu!
Dialogue: 0,0:00:15.52,0:00:17.10,Default,,0,0,0,,{\i1}Bu çok tuhaftı.{\i}
Dialogue: 0,0:00:18.69,0:00:20.98,Default,,0,0,0,,Hey, orada öyle neye dalıp gittin bakalım?
Dialogue: 0,0:00:21.06,0:00:22.69,Default,,0,0,0,,Ah, bir şey yok.
Dialogue: 0,0:00:23.65,0:00:24.73,Default,,0,0,0,,PREMİUM HOTEL ESCORT HİZMETİ
Dialogue: 0,0:00:24.82,0:00:26.53,Default,,0,0,0,,Vay! Hâlâ burada mı yaşıyorsun?
Dialogue: 0,0:00:26.61,0:00:28.95,Default,,0,0,0,,Bu eski mekân beni geçmişe götürüyor.
Dialogue: 0,0:00:29.03,0:00:31.24,Default,,0,0,0,,Inupi hâlâ dükkânın üst katında yaşıyor.
Dialogue: 0,0:00:31.32,0:00:33.99,Default,,0,0,0,,Ben de hâlâ geçim derdindeyim.
Dialogue: 0,0:00:34.08,0:00:37.20,Default,,0,0,0,,Yardım ettiğim sürece\Nyanlarında kalmama ses çıkarmıyorlar.
Dialogue: 0,0:00:39.00,0:00:40.87,Default,,0,0,0,,Dördüncü kattasın, değil mi?
Dialogue: 0,0:00:40.96,0:00:42.83,Default,,0,0,0,,Evet. Hafızan iyi.
Dialogue: 0,0:00:42.92,0:00:45.05,Default,,0,0,0,,Dördüncü kata çıkan tuş.
Dialogue: 0,0:00:47.92,0:00:48.92,Default,,0,0,0,,{\i1}Kan mı?{\i}
Dialogue: 0,0:00:49.01,0:00:50.88,Default,,0,0,0,,{\i1}Ne oluyor lan?{\i}
Dialogue: 0,0:00:52.09,0:00:53.30,Default,,0,0,0,,Ha?
Dialogue: 0,0:00:55.10,0:00:56.68,Default,,0,0,0,,{\i1}Dur, ben iyiyim.{\i}
Dialogue: 0,0:00:57.18,0:00:58.18,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:00:58.27,0:00:59.52,Default,,0,0,0,,Şey, evet.
Dialogue: 0,0:01:01.23,0:01:03.19,Default,,0,0,0,,{\i1}Bu, şimdiye kadar ikinci kez oluyor.{\i}
Dialogue: 0,0:01:03.27,0:01:04.98,Default,,0,0,0,,{\i1}Bana ne oluyor?{\i}
Dialogue: 0,0:01:05.57,0:01:06.73,Default,,0,0,0,,{\i1}Ve neden?{\i}
Dialogue: 0,0:02:43.08,0:02:44.41,Default,,0,0,0,,{\an8}Senmişsin.
Dialogue: 0,0:02:44.50,0:02:46.00,Default,,0,0,0,,{\an8}Tabii.
Dialogue: 0,0:02:46.71,0:02:49.04,Default,,0,0,0,,{\an8}Bu adam, beni adeta kendi eliyle büyüttü.
Dialogue: 0,0:02:49.13,0:02:50.96,Default,,0,0,0,,{\an8}Şey, memnun oldum.
Dialogue: 0,0:02:51.05,0:02:53.76,Default,,0,0,0,,{\an8}Hıh. Anlaşılan daha önce buraya gelmişsin.
Dialogue: 0,0:02:53.84,0:02:54.84,Default,,0,0,0,,{\an8}Evet!
Dialogue: 0,0:02:56.22,0:02:58.80,Default,,0,0,0,,Ken, beni arabana aldığın için\Ntekrar teşekkür ederim.
Dialogue: 0,0:02:58.89,0:02:59.89,Default,,0,0,0,,Tabii.
Dialogue: 0,0:02:59.97,0:03:02.22,Default,,0,0,0,,Ah, Ken, bir konuda tavsiyeni almak istiyorum.
Dialogue: 0,0:03:02.31,0:03:03.93,Default,,0,0,0,,Evet, sonra konuşuruz.
Dialogue: 0,0:03:04.02,0:03:07.19,Default,,0,0,0,,- O karın kaslarına dokunmama ne zaman izin vereceksin?\N- Asla.
Dialogue: 0,0:03:08.94,0:03:11.94,Default,,0,0,0,,Bu kadınlarla daha önce tanışmıştım.\NHepsi bugün izinli mi?
Dialogue: 0,0:03:12.53,0:03:15.74,Default,,0,0,0,,Tam olarak değil.\NHepsi bir süre önce işten ayrıldı.
Dialogue: 0,0:03:15.82,0:03:17.91,Default,,0,0,0,,Bu sektörde işten ayrılma oranı oldukça yüksek.
Dialogue: 0,0:03:22.66,0:03:24.96,Default,,0,0,0,,Vay be! Burası eskisinden\Ndaha geniş görünüyor.
Dialogue: 0,0:03:25.04,0:03:28.29,Default,,0,0,0,,Ee, evet. Depo odasını temizlersem alabileceğimi söylediler.
Dialogue: 0,0:03:29.88,0:03:32.09,Default,,0,0,0,,Toman’ın tüm bu eski fotoğrafları!
Dialogue: 0,0:03:32.17,0:03:33.46,Default,,0,0,0,,Ben de varım.
Dialogue: 0,0:03:35.47,0:03:36.63,Default,,0,0,0,,{\i1}Emma.{\i}
Dialogue: 0,0:03:38.14,0:03:40.80,Default,,0,0,0,,Hâlâ rüyalarımda sesini duyabiliyorum.
Dialogue: 0,0:03:43.97,0:03:46.77,Default,,0,0,0,,Mikey'yi kurtarmamı istiyor. İşimiz zor.
Dialogue: 0,0:03:50.86,0:03:54.11,Default,,0,0,0,,Ama bunu yapmak zorundayım, değil mi? Onu yüzüstü bırakamam.
Dialogue: 0,0:03:55.15,0:03:56.70,Default,,0,0,0,,{\i1}Doğru.{\i}
Dialogue: 0,0:03:56.78,0:04:00.91,Default,,0,0,0,,{\i1}Hatta bunun için Brahman’la iş birliği bile yaptı.\NArtık bu işe kendini adadı.{\i}
Dialogue: 0,0:04:02.83,0:04:04.74,Default,,0,0,0,,{\i1}Ama birlikte olduğumuz sürece...{\i}
Dialogue: 0,0:04:07.21,0:04:08.92,Default,,0,0,0,,Bir şey bilmem gerekiyor, Takemitchy.
Dialogue: 0,0:04:09.00,0:04:10.04,Default,,0,0,0,,Ha?
Dialogue: 0,0:04:10.13,0:04:12.75,Default,,0,0,0,,Onu gördüğünde,\Nnasıldı?
Dialogue: 0,0:04:19.22,0:04:20.39,Default,,0,0,0,,Zayıftı.
Dialogue: 0,0:04:21.01,0:04:24.64,Default,,0,0,0,,Gözlerinin altı, sanki uyumamış gibi morarmıştı.
Dialogue: 0,0:04:25.60,0:04:27.81,Default,,0,0,0,,Bonten adındaki bir çetenin lideriydi.
Dialogue: 0,0:04:28.81,0:04:32.02,Default,,0,0,0,,Aslında, bir çeteden daha fazlası.
Dialogue: 0,0:04:32.11,0:04:34.27,Default,,0,0,0,,Yani bir suç örgütü gibi mi?
Dialogue: 0,0:04:34.36,0:04:35.36,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:36.57,0:04:40.32,Default,,0,0,0,,Bir de mesaj bırakmıştı.\Nİçinde Karanlık Dürtü denen bir şey varmış.
Dialogue: 0,0:04:40.82,0:04:42.91,Default,,0,0,0,,Kontrol edemediği bir şey.
Dialogue: 0,0:04:44.91,0:04:49.54,Default,,0,0,0,,Fakat diğer geleceklerde de olduğu gibi, Hina hâlâ yaşıyordu.
Dialogue: 0,0:04:49.62,0:04:51.21,Default,,0,0,0,,İLK NESİL TOKYO MANJI\N
Dialogue: 0,0:04:51.29,0:04:55.84,Default,,0,0,0,,{\i1}Daha önce ölmüş olan sen ve Mitsuya da...\NChifuyu, Hakkai, Pah-chin ve Peh-yan da...{\i}
Dialogue: 0,0:04:55.92,0:04:57.51,Default,,0,0,0,,{\i1}hepiniz iyiydiniz.{\i}
Dialogue: 0,0:05:00.05,0:05:03.80,Default,,0,0,0,,İki yıl önce,\NMikey, ben ayrılmadan hemen önce bana söz verdi.
Dialogue: 0,0:05:04.93,0:05:09.27,Default,,0,0,0,,12 yıl sonra tekrar karşılaşana dek\Nherkesi koruyacağını söyledi.
Dialogue: 0,0:05:11.06,0:05:13.65,Default,,0,0,0,,Gördüğüm gelecek,\Ntam da söz verdiği gibiydi.
Dialogue: 0,0:05:14.52,0:05:15.52,Default,,0,0,0,,Ancak...
Dialogue: 0,0:05:17.82,0:05:20.57,Default,,0,0,0,,Kendini nasıl koruyacağını bildiğini sanmıyorum.
Dialogue: 0,0:05:24.83,0:05:27.29,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:05:28.70,0:05:30.50,Default,,0,0,0,,Buna “Karanlık Dürtü” mü dedi?
Dialogue: 0,0:05:30.58,0:05:31.87,Default,,0,0,0,,Hı hı.
Dialogue: 0,0:05:32.58,0:05:34.33,Default,,0,0,0,,Sanırım ne demek istediğini anladım.
Dialogue: 0,0:05:34.88,0:05:37.21,Default,,0,0,0,,Kendi gibi olmadığı zamanlar vardı.
Dialogue: 0,0:05:38.71,0:05:41.84,Default,,0,0,0,,{\i1}Toman henüz birkaç kişiden oluşan bir ekipken bile,{\i}
Dialogue: 0,0:05:42.51,0:05:45.35,Default,,0,0,0,,{\i1}bunu fark etti, ne olduğunu anladı,{\i}
Dialogue: 0,0:05:45.43,0:05:47.06,Default,,0,0,0,,{\i1}ama bunun üstesinden gelemedi.{\i}
Dialogue: 0,0:05:47.14,0:05:48.52,Default,,0,0,0,,{\i1}Bu onu mahvetti.\N{\i}
Dialogue: 0,0:05:50.39,0:05:55.02,Default,,0,0,0,,{\i1}Sonra ertesi gün onu görürdüm;\Ngayet iyi olurdu.{\i}
Dialogue: 0,0:05:55.11,0:05:56.57,Default,,0,0,0,,{\i1}Sanki hepsi hayalmiş gibi.{\i}
Dialogue: 0,0:06:00.03,0:06:01.65,Default,,0,0,0,,{\i1}Madem bunu dile getirdi,{\i}
Dialogue: 0,0:06:02.45,0:06:05.28,Default,,0,0,0,,{\i1}Aslında en başından beri\Nbir şeylerin ters gittiği belliydi.{\i}
Dialogue: 0,0:06:06.16,0:06:11.66,Default,,0,0,0,,{\i1}Ama beni kabul edip bana güvenmesine\No kadar sevinmiştim ki...{\i}
Dialogue: 0,0:06:15.38,0:06:18.67,Default,,0,0,0,,Çevresindeki insanları nasıl etkileyeceğini öngörmüş olmalı.
Dialogue: 0,0:06:21.38,0:06:22.92,Default,,0,0,0,,Böylece bizi kendinden uzaklaştırdı.
Dialogue: 0,0:06:23.55,0:06:25.22,Default,,0,0,0,,Sadece bizi terk edip gitmiş değil.
Dialogue: 0,0:06:26.89,0:06:28.47,Default,,0,0,0,,{\i1}İlk önce o bize zarar verdi.{\i}
Dialogue: 0,0:06:29.31,0:06:31.10,Default,,0,0,0,,{\i1}Bizim ondan nefret etmemizi istiyordu.{\i}
Dialogue: 0,0:06:31.68,0:06:33.14,Default,,0,0,0,,{\i1}Ve biz de öyle yaptık.{\i}
Dialogue: 0,0:06:34.44,0:06:36.15,Default,,0,0,0,,{\i1}Bu inanılmaz bir şey.{\i}
Dialogue: 0,0:06:37.44,0:06:41.36,Default,,0,0,0,,Bu “Karanlık Dürtü”nün ne olduğunu\Nya da ona gerçekte ne yaptığını bilmiyorum,
Dialogue: 0,0:06:42.24,0:06:45.32,Default,,0,0,0,,Fakat bizimle bağlarını kopardığında,\Nhepimiz hayatımızı yoluna koyduk.
Dialogue: 0,0:06:45.86,0:06:47.57,Default,,0,0,0,,Bunu inkâr edemeyiz.
Dialogue: 0,0:06:48.83,0:06:52.83,Default,,0,0,0,,{\i1}Acaba sana o sözü verdiğinde,\Nbunu zaten planlıyor muydu...{\i}
Dialogue: 0,0:06:57.50,0:07:00.59,Default,,0,0,0,,...hepimizi, onun içindeki tehlikeden korumak için.
Dialogue: 0,0:07:00.67,0:07:04.30,Default,,0,0,0,,Ama amacı ne olursa olsun,\Nişe yaradığını kabul etmen gerek.
Dialogue: 0,0:07:04.38,0:07:07.64,Default,,0,0,0,,Sanırım öyle, ama ben...
Dialogue: 0,0:07:09.72,0:07:11.14,Default,,0,0,0,,Tam bir aptal.
Dialogue: 0,0:07:14.10,0:07:16.48,Default,,0,0,0,,Bir an için gerçekten endişelendim.
Dialogue: 0,0:07:16.56,0:07:19.31,Default,,0,0,0,,Ancak şimdi doğru olanı yaptığımızdan eminim.
Dialogue: 0,0:07:23.90,0:07:27.20,Default,,0,0,0,,Biliyorsun, gelecek,\Nonu en son gördüğün zamankinden zaten farklı olmalı.
Dialogue: 0,0:07:27.28,0:07:28.66,Default,,0,0,0,,Ha?
Dialogue: 0,0:07:28.74,0:07:29.87,Default,,0,0,0,,{\i1}Haklı.{\i}
Dialogue: 0,0:07:30.62,0:07:33.79,Default,,0,0,0,,{\i1}Sadece Brahman'a katılarak,\Ngeçmişin bir kısmını şimdiden değiştirdim.{\i}
Dialogue: 0,0:07:35.00,0:07:38.25,Default,,0,0,0,,Bundan sonra bu çetelerle işler iyice karışacak.
Dialogue: 0,0:07:38.33,0:07:39.71,Default,,0,0,0,,Öyleyse kendini hazırla.
Dialogue: 0,0:07:40.46,0:07:43.00,Default,,0,0,0,,Gerekirse Mikey'yi eve sürükleriz,
Dialogue: 0,0:07:43.09,0:07:45.76,Default,,0,0,0,,O Karanlık Dürtü'yü de ezip geçeriz.
Dialogue: 0,0:07:45.84,0:07:46.97,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:47.05,0:07:50.51,Default,,0,0,0,,{\i1}Bu yapacağım son şey olsa bile\Nonu kurtaracağım!{\i}
Dialogue: 0,0:07:51.76,0:07:54.64,Default,,0,0,0,,Aman, hayır! Özür dilerim!
Dialogue: 0,0:07:57.19,0:07:59.10,Default,,0,0,0,,Vurulmuş gibisin.
Dialogue: 0,0:07:59.19,0:08:01.65,Default,,0,0,0,,Çok özür dilerim. Dur, temizleyeyim.
Dialogue: 0,0:08:02.52,0:08:04.36,Default,,0,0,0,,{\i1}İşte bu, gördüğüm o tuhaf an.{\i}
Dialogue: 0,0:08:05.86,0:08:06.86,Default,,0,0,0,,{\i1}Aman Tanrım.{\i}
Dialogue: 0,0:08:10.91,0:08:12.62,Default,,0,0,0,,Geleceği mi görüyorum?
Dialogue: 0,0:08:15.95,0:08:18.04,Default,,0,0,0,,Bu kabul edilemez.
Dialogue: 0,0:08:18.12,0:08:22.29,Default,,0,0,0,,O serseriler işimi baltalamak için\Nyakuzayı bile devreye sokmuş!
Dialogue: 0,0:08:23.04,0:08:25.51,Default,,0,0,0,,Ailem için son derece endişeliyim,\Nanlıyor musunuz?
Dialogue: 0,0:08:26.55,0:08:29.47,Default,,0,0,0,,Ama bize yardımcı olabilirsin, değil mi?
Dialogue: 0,0:08:29.55,0:08:32.43,Default,,0,0,0,,Sanki başka seçeneğim varmış gibi.
Dialogue: 0,0:08:35.64,0:08:38.10,Default,,0,0,0,,Arkamızda Brahman varken,\No küçük serserileri hallederiz.
Dialogue: 0,0:08:38.18,0:08:39.81,Default,,0,0,0,,Ve kimse bize engel olamaz.
Dialogue: 0,0:08:41.19,0:08:44.57,Default,,0,0,0,,Sen geleceği olmayan bir işin başında,\Nkabadayılık taslayan yaşlı bir herifsin.
Dialogue: 0,0:08:44.65,0:08:47.69,Default,,0,0,0,,Sen büyük, sert bir suç baronu falan değilsin!\NBoyunu aşan işlere kalkışmışsın.
Dialogue: 0,0:08:48.99,0:08:52.45,Default,,0,0,0,,B-ben kendim çıkarım.
Dialogue: 0,0:08:53.74,0:08:55.83,Default,,0,0,0,,Senju, çok büyük bir müşteri.
Dialogue: 0,0:08:57.87,0:09:00.83,Default,,0,0,0,,Biliyorum, sadece yasal işlerle\Nayakta kalmamız zor.
Dialogue: 0,0:09:01.58,0:09:06.00,Default,,0,0,0,,Ama Brahman'ın adının o tiplerle\Nyan yana gelmesi sinirimi bozuyor.
Dialogue: 0,0:09:06.50,0:09:07.80,Default,,0,0,0,,beni sinirlendiriyor.
Dialogue: 0,0:09:07.88,0:09:09.80,Default,,0,0,0,,Bunu ayrı değerlendirmeliyiz.
Dialogue: 0,0:09:09.88,0:09:12.18,Default,,0,0,0,,Duygular işin önüne geçemez.
Dialogue: 0,0:09:18.48,0:09:20.39,Default,,0,0,0,,Mikey bu konuda hep iyiydi.
Dialogue: 0,0:09:22.02,0:09:23.48,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:09:30.32,0:09:33.99,Default,,0,0,0,,Vay be, Brahman toplantıları\Nnormal bir ofiste mi yapılıyor?
Dialogue: 0,0:09:34.95,0:09:38.70,Default,,0,0,0,,{\i1}Gerçi "normal" demek pek doğru olmaz.\NGüvenlik önlemleri inanılmaz.{\i}
Dialogue: 0,0:09:46.00,0:09:48.55,Default,,0,0,0,,Vay be!\NBöyle etkinlikler sık mı düzenleniyor?
Dialogue: 0,0:09:48.63,0:09:49.71,Default,,0,0,0,,Adı B1.
Dialogue: 0,0:09:50.80,0:09:53.22,Default,,0,0,0,,Brahman'ın işlettiği\Nbir yeraltı dövüş kulübü.
Dialogue: 0,0:09:54.64,0:09:56.93,Default,,0,0,0,,Üzerlerinde kameralar, monitörler falan var,
Dialogue: 0,0:09:57.01,0:09:59.35,Default,,0,0,0,,böylece kodamanlar para yatırabilsinler.
Dialogue: 0,0:09:59.43,0:10:00.68,Default,,0,0,0,,Kumar da mı?
Dialogue: 0,0:10:00.77,0:10:02.31,Default,,0,0,0,,Toplantı yapıldığını sanmıştım.
Dialogue: 0,0:10:02.94,0:10:04.52,Default,,0,0,0,,Bu çok riskli değil mi?
Dialogue: 0,0:10:05.23,0:10:06.98,Default,,0,0,0,,Aldıkları eğitimi kazanca çeviriyorlar.
Dialogue: 0,0:10:07.07,0:10:10.24,Default,,0,0,0,,Dövüşmek işin olunca da\Nister istemez ustalaşıyorsun.
Dialogue: 0,0:10:11.32,0:10:14.49,Default,,0,0,0,,Üst düzey muharebe eğitimi almış suçlulardan oluşan seçkin bir ekip.
Dialogue: 0,0:10:14.57,0:10:16.16,Default,,0,0,0,,Brahman'ın belkemiğini\Nişte bu adamlar oluşturuyor.
Dialogue: 0,0:10:17.58,0:10:18.99,Default,,0,0,0,,- Yeter!\N- Hı?
Dialogue: 0,0:10:21.54,0:10:24.00,Default,,0,0,0,,Kameraları kapatın! Bu gecelik işimiz bitti.
Dialogue: 0,0:10:26.25,0:10:29.67,Default,,0,0,0,,-  Senju! Senju! Senju!\N-  Senju! Senju! Senju!
Dialogue: 0,0:10:30.55,0:10:35.22,Default,,0,0,0,,Ve en tepede, hepsinden tehlikeli\Nbir dövüşçü var...
Dialogue: 0,0:10:35.30,0:10:38.35,Default,,0,0,0,,-  Senju! Senju! Senju!\N-  Senju! Senju! Senju!
Dialogue: 0,0:10:38.43,0:10:40.72,Default,,0,0,0,,...Senju Kawaragi.
Dialogue: 0,0:10:49.07,0:10:52.49,Default,,0,0,0,,Bu akşam Brahman'ın genel kuruluna katıldığınız için size teşekkür ederim.
Dialogue: 0,0:10:53.40,0:10:55.36,Default,,0,0,0,,Aramızda yeni bir üye var.
Dialogue: 0,0:10:56.45,0:10:58.78,Default,,0,0,0,,Öne çık, Takemichi Hanagaki!
Dialogue: 0,0:11:03.12,0:11:06.67,Default,,0,0,0,,3 Ağustos Savaşı, Kanlı Cadılar Bayramı,
Dialogue: 0,0:11:06.75,0:11:09.09,Default,,0,0,0,,Kara Ejderha ile Noel Çatışması,
Dialogue: 0,0:11:09.17,0:11:12.01,Default,,0,0,0,,ve Kanto Olayı’nın kilit ismi,
Dialogue: 0,0:11:12.09,0:11:16.01,Default,,0,0,0,,Tokyo Manji Çetesi'nin efsanevi eski Birinci Bölük Kaptanı
Dialogue: 0,0:11:16.09,0:11:18.93,Default,,0,0,0,,Ve Kara Ejder çetesinin son mirasçısı!
Dialogue: 0,0:11:24.89,0:11:28.48,Default,,0,0,0,,Takemichi Hanagaki, Brahman'a hoş geldin...
Dialogue: 0,0:11:37.24,0:11:39.07,Default,,0,0,0,,Pazartesi, 14 Temmuz,
Dialogue: 0,0:11:39.16,0:11:44.25,Default,,0,0,0,,Kanto Manji Çetesi ve Rokuhara Tandai'ye karşı iki cepheden harekete geçeceğiz!
Dialogue: 0,0:11:44.33,0:11:47.25,Default,,0,0,0,,Brahman, Üç Titan Savaşı'nı başlatacak!
Dialogue: 0,0:11:52.59,0:11:53.63,Default,,0,0,0,,{\i1}Peki!{\i}
Dialogue: 0,0:11:54.30,0:11:56.05,Default,,0,0,0,,{\i1}Sana geliyorum, Mikey.{\i}
Dialogue: 0,0:11:59.39,0:12:01.35,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:03.14,0:12:05.48,Default,,0,0,0,,Evet, şu an her şey sorunsuz ilerliyor.
Dialogue: 0,0:12:05.56,0:12:06.98,Default,,0,0,0,,Motorun devirleri harika hissettiriyor.
Dialogue: 0,0:12:07.81,0:12:10.44,Default,,0,0,0,,Bir de artık yağ sızıntısı yok.\NEn azından benim fark ettiğim kadarıyla.
Dialogue: 0,0:12:10.52,0:12:14.32,Default,,0,0,0,,{\i1}İyi.\NPeki, bir şeye ihtiyacı olursa, seslen yeter.{\i}
Dialogue: 0,0:12:14.40,0:12:16.86,Default,,0,0,0,,Tamamdır. Tüm bunlar için teşekkürler.
Dialogue: 0,0:12:21.57,0:12:25.20,Default,,0,0,0,,- Şey, sana bir şey sorabilir miyim?\N- {\i1}Hayırdır?{\i}
Dialogue: 0,0:12:25.29,0:12:28.71,Default,,0,0,0,,Mesele Senju Kawaragi.\NYani, olayı ne bu kızın?
Dialogue: 0,0:12:29.21,0:12:30.63,Default,,0,0,0,,{\i1}"Olayı ne mi?"{\i}
Dialogue: 0,0:12:31.13,0:12:34.63,Default,,0,0,0,,Bilmiyorum ya. Onu her gördüğümde\Nbambaşka biri gibi duruyor.
Dialogue: 0,0:12:34.71,0:12:36.01,Default,,0,0,0,,Oh?
Dialogue: 0,0:12:45.22,0:12:46.35,Default,,0,0,0,,Senju?
Dialogue: 0,0:12:47.81,0:12:49.06,Default,,0,0,0,,Randevuya çıkıyoruz.
Dialogue: 0,0:12:50.06,0:12:51.06,Default,,0,0,0,,TRINITY LAND
Dialogue: 0,0:12:51.15,0:12:52.23,Default,,0,0,0,,Oğlum!
Dialogue: 0,0:12:52.31,0:12:55.02,Default,,0,0,0,,Ayağa kalkman lazım!\NManzara fena!
Dialogue: 0,0:12:56.48,0:12:57.74,Default,,0,0,0,,Şu parıltılara baksana!
Dialogue: 0,0:12:57.82,0:13:00.03,Default,,0,0,0,,Vay be, buraya küçücükken\Ngelmiştim en son.
Dialogue: 0,0:13:08.04,0:13:11.46,Default,,0,0,0,,{\i1}Harbiden ne zaman görüşsek{\i}\N{\i1}farklı birine dönüşüyor sanki.{\i}
Dialogue: 0,0:13:11.54,0:13:14.79,Default,,0,0,0,,- Hı?\N- Şey, kusura bakma da... Geçen gün
Dialogue: 0,0:13:14.88,0:13:17.21,Default,,0,0,0,,onca güzel kıyafet almışken\Nniye üniformayla geldin ki?
Dialogue: 0,0:13:17.92,0:13:20.43,Default,,0,0,0,,Harbici, en rahat ettiğim kıyafet bu.
Dialogue: 0,0:13:21.13,0:13:24.26,Default,,0,0,0,,{\an7\fscx75\fscy75}*: Soylu ve safkan Arap atı.
Dialogue: 0,0:13:21.13,0:13:24.26,Default,,0,0,0,,İleri, asil küheylanım!* Zafere doğru!
Dialogue: 0,0:13:24.35,0:13:27.56,Default,,0,0,0,,Çocuk oyuncaklarına hâlâ bu kadar\Nyükselmene şaşırmamak lazım tabii.
Dialogue: 0,0:13:28.14,0:13:31.64,Default,,0,0,0,,{\i1}Anlamıyorum abi, çözemiyorum şu kızı.\Nİçinde on iki farklı tip var sanki.{\i}
Dialogue: 0,0:13:36.27,0:13:38.94,Default,,0,0,0,,{\an7\fscx75\fscy75}*: War of the Three Titans
Dialogue: 0,0:13:36.27,0:13:38.94,Default,,0,0,0,,Ayın 14'ündeki\NÜç Titan Savaşı'nda*,
Dialogue: 0,0:13:39.49,0:13:42.78,Default,,0,0,0,,Senin ve Draken'ın Kanto Manji'ye\Ndalacağınızı düşünüyorum.
Dialogue: 0,0:13:42.86,0:13:44.20,Default,,0,0,0,,Ha?
Dialogue: 0,0:13:44.28,0:13:47.12,Default,,0,0,0,,Takeomi'yle ben de Rokuhara Tandai'yi hallederiz.
Dialogue: 0,0:13:49.16,0:13:53.04,Default,,0,0,0,,Gerçi açık konuşayım, bu işi\Nsadece kendi bileğimin hakkıyla bitirmek isterdim.
Dialogue: 0,0:13:54.75,0:13:58.96,Default,,0,0,0,,Mikey'yi de South'u da devirmek istiyorum.\NO zaman önümde kimse duramaz işte.
Dialogue: 0,0:14:05.68,0:14:06.68,Default,,0,0,0,,Hazır mısın?
Dialogue: 0,0:14:06.76,0:14:08.14,Default,,0,0,0,,Ha?
Dialogue: 0,0:14:10.68,0:14:13.31,Default,,0,0,0,,Ölücem lan!
Dialogue: 0,0:14:15.44,0:14:18.02,Default,,0,0,0,,Takeomi artık eski Takeomi değil, biraz da ondan.
Dialogue: 0,0:14:19.44,0:14:23.45,Default,,0,0,0,,O, Brahman'ın piyasasını büyütme derdinde.\NBense bileğimizin güçlenmesinden yanayım.
Dialogue: 0,0:14:23.53,0:14:24.95,Default,,0,0,0,,Bu da beni ayar ediyor işte.
Dialogue: 0,0:14:26.45,0:14:30.12,Default,,0,0,0,,Ama Tokyo Manji de zaten\Nsağlam olduğu için büyümedi mi?
Dialogue: 0,0:14:30.20,0:14:33.66,Default,,0,0,0,,Ağzımı açmamın hayati tehlike\Nyaratmadığı bir zaman cevap veririm.
Dialogue: 0,0:14:33.75,0:14:38.25,Default,,0,0,0,,Takeomi'nin kafasında ne varsa,\Nbenim hayal ettiğim şey değil.
Dialogue: 0,0:14:39.05,0:14:41.59,Default,,0,0,0,,Onun büyümekten anladığı\Nbambaşka bir şey.
Dialogue: 0,0:14:41.67,0:14:44.18,Default,,0,0,0,,Daha karmaşık, daha geniş çaplı bir şey.
Dialogue: 0,0:14:46.18,0:14:51.14,Default,,0,0,0,,İşin içine bu kadar adam girip\Nher kafadan bir ses çıkınca kimse mutlu olmuyor.
Dialogue: 0,0:14:54.19,0:14:55.52,Default,,0,0,0,,İşte bu yüzden...
Dialogue: 0,0:14:58.56,0:14:59.94,Default,,0,0,0,,Sıkı tutun!
Dialogue: 0,0:15:00.02,0:15:01.03,Default,,0,0,0,,Ha?
Dialogue: 0,0:15:03.86,0:15:05.61,Default,,0,0,0,,Ama işler iyice büyümeden önce,
Dialogue: 0,0:15:05.70,0:15:07.99,Default,,0,0,0,,Üç Titan Dönemi'ne\Ndamgamı vuracağım!
Dialogue: 0,0:15:08.07,0:15:12.50,Default,,0,0,0,,Şu muhabbeti ikimiz de yere\Nsağ salim inince yapsak olmaz mı ya?
Dialogue: 0,0:15:19.00,0:15:20.17,Default,,0,0,0,,Kusacağım şimdi.
Dialogue: 0,0:15:20.25,0:15:22.00,Default,,0,0,0,,Hanagaki, şuraya bak.
Dialogue: 0,0:15:22.59,0:15:23.59,Default,,0,0,0,,Dilek kâğıtları.
Dialogue: 0,0:15:24.30,0:15:27.26,Default,,0,0,0,,{\an7}{\fs48}*: 7 Temmuz'da kutlanan Japon dilek festivali.
Dialogue: 0,0:15:24.30,0:15:27.26,Default,,0,0,0,,Aa, doğru ya. Bugün Tanabata Festivali.*
Dialogue: 0,0:15:29.30,0:15:31.97,Default,,0,0,0,,Ne dilesem, ne dilesem...
Dialogue: 0,0:15:32.06,0:15:34.10,Default,,0,0,0,,Al, sen de bir dilek yaz bakalım.
Dialogue: 0,0:15:34.18,0:15:35.69,Default,,0,0,0,,Ha... Tamam.
Dialogue: 0,0:15:40.57,0:15:41.57,Default,,0,0,0,,Hı?
Dialogue: 0,0:15:41.65,0:15:43.78,Default,,0,0,0,,- Ne yazdın, bir bakayım.\N- Hı?
Dialogue: 0,0:15:44.57,0:15:46.74,Default,,0,0,0,,"Mikey'nin şalterini indirmek" mi?
Dialogue: 0,0:15:46.82,0:15:48.91,Default,,0,0,0,,Senin de tek derdin bu zaten.
Dialogue: 0,0:15:48.99,0:15:52.58,Default,,0,0,0,,Ya kessene sesini.\NKendimi gaza getirmeye çalışıyorum işte.
Dialogue: 0,0:15:52.66,0:15:56.50,Default,,0,0,0,,O zaman benim dileğim de...
Dialogue: 0,0:15:56.58,0:15:57.83,Default,,0,0,0,,- İşte!\N- Hı?
Dialogue: 0,0:15:59.50,0:16:01.54,Default,,0,0,0,,"Hanagaki'yi korumak."
Dialogue: 0,0:16:02.13,0:16:03.63,Default,,0,0,0,,{\i1}Harbiden kral kız ya.{\i}
Dialogue: 0,0:16:04.67,0:16:05.67,Default,,0,0,0,,Sağ ol.
Dialogue: 0,0:16:05.76,0:16:07.88,Default,,0,0,0,,İlk defa böyle bir şey yapıyorum.
Dialogue: 0,0:16:10.18,0:16:12.51,Default,,0,0,0,,Biz artık arkadaş sayılırız, değil mi?
Dialogue: 0,0:16:16.27,0:16:17.56,Default,,0,0,0,,Evet.
Dialogue: 0,0:16:18.60,0:16:19.60,Default,,0,0,0,,Tabii ki.
Dialogue: 0,0:16:21.69,0:16:25.19,Default,,0,0,0,,O zaman benim de elimden geldiğince\Nseni kollamam gerek.
Dialogue: 0,0:16:25.28,0:16:26.90,Default,,0,0,0,,Salak mısın sen?
Dialogue: 0,0:16:26.99,0:16:28.36,Default,,0,0,0,,Boşuna söz verip durma.
Dialogue: 0,0:16:28.86,0:16:30.53,Default,,0,0,0,,Hem ben senden güçlüyüm zaten.
Dialogue: 0,0:16:32.24,0:16:33.62,Default,,0,0,0,,Orası doğru.
Dialogue: 0,0:16:35.16,0:16:37.66,Default,,0,0,0,,Ama yine de... Sağ ol.
Dialogue: 0,0:16:41.17,0:16:43.38,Default,,0,0,0,,Senju!
Dialogue: 0,0:16:44.25,0:16:45.59,Default,,0,0,0,,Hanagaki...
Dialogue: 0,0:16:47.63,0:16:50.59,Default,,0,0,0,,Gördün mü? Dileğim gerçek oldu.
Dialogue: 0,0:16:50.68,0:16:52.26,Default,,0,0,0,,{\i1}Yine mi?{\i}
Dialogue: 0,0:16:52.35,0:16:54.60,Default,,0,0,0,,{\i1}Bir dakika... Lunapark mı?{\i}
Dialogue: 0,0:16:56.22,0:16:57.77,Default,,0,0,0,,{\i1}Bu sefer daha net gördüm.{\i}
Dialogue: 0,0:16:59.56,0:17:01.23,Default,,0,0,0,,İyi misin? Ne oldu?
Dialogue: 0,0:17:01.77,0:17:03.48,Default,,0,0,0,,{\i1}Niye sürekli böyle oluyor?{\i}
Dialogue: 0,0:17:05.23,0:17:06.73,Default,,0,0,0,,Aa, yağmur.
Dialogue: 0,0:17:07.69,0:17:10.32,Default,,0,0,0,,{\i1}Yağmur, lunapark...{\i}
Dialogue: 0,0:17:13.57,0:17:14.70,Default,,0,0,0,,{\i1}Yoksa...{\i}
Dialogue: 0,0:17:19.71,0:17:23.33,Default,,0,0,0,,Temmuz gelince böyle işte.\NYağmurun ardı arkası kesilmiyor.
Dialogue: 0,0:17:24.38,0:17:25.88,Default,,0,0,0,,- Hı.\N- Draken!
Dialogue: 0,0:17:26.80,0:17:28.76,Default,,0,0,0,,Inupi, hayırdır?
Dialogue: 0,0:17:28.84,0:17:30.47,Default,,0,0,0,,Atla, Hanagaki'yle ilgili.
Dialogue: 0,0:17:30.97,0:17:32.34,Default,,0,0,0,,Başına bela açılacak!
Dialogue: 0,0:17:35.18,0:17:38.68,Default,,0,0,0,,Şu yağmura bak.\NResmen bardaktan boşanırcasına yağıyor.
Dialogue: 0,0:17:40.89,0:17:42.27,Default,,0,0,0,,Hımm...
Dialogue: 0,0:17:42.94,0:17:45.98,Default,,0,0,0,,Hâlâ miden mi bulanıyor?\NAğzına lokma koymadın.
Dialogue: 0,0:17:46.07,0:17:49.49,Default,,0,0,0,,- Yok, iyiyim.\N- İyi o zaman. Ben bir tuvalete gideyim.
Dialogue: 0,0:17:49.57,0:17:50.57,Default,,0,0,0,,Tamam.
Dialogue: 0,0:17:56.70,0:17:58.79,Default,,0,0,0,,{\i1}Ne yapacağım ben şimdi?{\i}
Dialogue: 0,0:17:58.87,0:18:01.41,Default,,0,0,0,,{\i1}Az önce gördüğüm şey gerçekten\Ngelecekten bir kesitse,{\i}
Dialogue: 0,0:18:01.50,0:18:05.29,Default,,0,0,0,,{\i1}Senju bugün, tam da burada...{\i}
Dialogue: 0,0:18:06.67,0:18:08.84,Default,,0,0,0,,Kahretsin! Niye tek başına gönderdim ki?
Dialogue: 0,0:18:09.55,0:18:11.80,Default,,0,0,0,,Senju! Sesimi duyuyorsan\Nbir cevap ver, ne olur!
Dialogue: 0,0:18:12.63,0:18:14.43,Default,,0,0,0,,{\i1}Hadi be, bir şey olmamış olsun.{\i}
Dialogue: 0,0:18:22.06,0:18:23.23,Default,,0,0,0,,Ha?
Dialogue: 0,0:18:24.52,0:18:28.40,Default,,0,0,0,,Biz de seni arıyorduk,\NTakemichi Hanagaki.
Dialogue: 0,0:18:29.94,0:18:31.24,Default,,0,0,0,,{\i1}Peşinde oldukları ben miyim?{\i}
Dialogue: 0,0:18:31.82,0:18:33.70,Default,,0,0,0,,{\i1}Tabii ya, şimdi anladım.{\i}
Dialogue: 0,0:18:34.32,0:18:37.74,Default,,0,0,0,,Gördün mü? Dileğim gerçek oldu.
Dialogue: 0,0:18:38.70,0:18:41.33,Default,,0,0,0,,- Hanagaki!\N- Senju!
Dialogue: 0,0:18:42.12,0:18:44.08,Default,,0,0,0,,{\i1}Beni korumaya çalışırken ölecek!{\i}
Dialogue: 0,0:18:44.58,0:18:46.79,Default,,0,0,0,,- Yaklaşma!\N- Kımıldama, Hanagaki!
Dialogue: 0,0:18:46.88,0:18:49.80,Default,,0,0,0,,- Sakın ha!\N- Senju! Geri çekil!
Dialogue: 0,0:19:03.23,0:19:04.69,Default,,0,0,0,,Kıstırdım seni, böcek.
Dialogue: 0,0:19:07.61,0:19:08.73,Default,,0,0,0,,Hanagaki?
Dialogue: 0,0:19:08.81,0:19:10.94,Default,,0,0,0,,Yaralandın mı? Konuş!
Dialogue: 0,0:19:11.98,0:19:12.99,Default,,0,0,0,,Ha?
Dialogue: 0,0:19:13.57,0:19:14.95,Default,,0,0,0,,Ölmene izin vermeyeceğim.
Dialogue: 0,0:19:17.91,0:19:18.91,Default,,0,0,0,,Siktir!
Dialogue: 0,0:19:18.99,0:19:21.62,Default,,0,0,0,,Hadi bakalım, bundan da sıyrılabilecek misin,\Nseni küçük şerefsiz!
Dialogue: 0,0:19:21.70,0:19:24.08,Default,,0,0,0,,{\i1}Ne yapacağım şimdi? Düşün lan, düşün!{\i}
Dialogue: 0,0:19:24.16,0:19:27.33,Default,,0,0,0,,Geber artık, Hanagaki!
Dialogue: 0,0:19:30.63,0:19:32.59,Default,,0,0,0,,Ha?
Dialogue: 0,0:19:37.97,0:19:40.10,Default,,0,0,0,,İyi misiniz lan? Vurulan falan var mı?
Dialogue: 0,0:19:40.64,0:19:42.68,Default,,0,0,0,,Draken! Evet, iyiyiz.
Dialogue: 0,0:19:48.31,0:19:49.94,Default,,0,0,0,,Berbat bir yağmur yağıyor.
Dialogue: 0,0:19:50.73,0:19:53.65,Default,,0,0,0,,Harbiden. Bir sıkıntı mı var, patron?
Dialogue: 0,0:19:56.99,0:19:58.78,Default,,0,0,0,,İçime kötü bir his doğdu sadece.
Dialogue: 0,0:20:00.37,0:20:02.74,Default,,0,0,0,,- O sesi duydun mu?\N- Duydum. Neydi o?
Dialogue: 0,0:20:15.63,0:20:17.47,Default,,0,0,0,,Draken, bizi kurtardığın için sağ ol.
Dialogue: 0,0:20:17.55,0:20:18.80,Default,,0,0,0,,Az daha...
Dialogue: 0,0:20:18.88,0:20:21.30,Default,,0,0,0,,Milletin ortasında silah çekmek de neyin nesi...
Dialogue: 0,0:20:22.22,0:20:24.72,Default,,0,0,0,,Senju! Harbiden iyi misin?\NBir yerin kanamıyor ya?
Dialogue: 0,0:20:24.81,0:20:27.18,Default,,0,0,0,,Yok, iyiyim.
Dialogue: 0,0:20:29.73,0:20:32.19,Default,,0,0,0,,Peki senin burada ne işin var?
Dialogue: 0,0:20:32.27,0:20:35.32,Default,,0,0,0,,Inupi, birkaç serserinin\Nseni hedef aldığını duymuş.
Dialogue: 0,0:20:35.40,0:20:38.11,Default,,0,0,0,,- Apar topar gelip bana haber verdi.\N- Ne?
Dialogue: 0,0:20:38.20,0:20:40.45,Default,,0,0,0,,Herhâlde adlarını duyurmak istiyorlar.
Dialogue: 0,0:20:40.53,0:20:42.37,Default,,0,0,0,,İyi de niye ben, abi?
Dialogue: 0,0:20:42.45,0:20:44.37,Default,,0,0,0,,Oğlum, ciddi misin sen?
Dialogue: 0,0:20:44.45,0:20:47.25,Default,,0,0,0,,Geçmişine bakılırsa\Nsen de az buz adam değilsin.
Dialogue: 0,0:20:47.33,0:20:49.67,Default,,0,0,0,,Yine de silah çekmek nedir ya?
Dialogue: 0,0:20:50.67,0:20:54.17,Default,,0,0,0,,Burası artık çocukların kavga ettiği\Nbir mahalle değil. İşler büyüdü.
Dialogue: 0,0:20:54.25,0:20:55.96,Default,,0,0,0,,- Ha?\N- Para hırsı, güç sevdası...
Dialogue: 0,0:20:56.05,0:20:58.05,Default,,0,0,0,,İşin içine ticaret ve nüfuz da girdi.
Dialogue: 0,0:20:58.13,0:21:00.38,Default,,0,0,0,,Artık herkesin kaybedeceği\Nçok daha fazla şey var.
Dialogue: 0,0:21:02.26,0:21:06.39,Default,,0,0,0,,Acaba Mikey, Üç Titan Savaşı'nın\Nçıkacağını önceden görmüş müydü?
Dialogue: 0,0:21:07.06,0:21:11.23,Default,,0,0,0,,Draken, Senju'nun beni korurken\Nöldüğü bir görüntü gördüm.
Dialogue: 0,0:21:12.35,0:21:15.52,Default,,0,0,0,,{\an8}Nasıl oluyor bilmiyorum ama\Ngaliba geleceği görebiliyorum.
Dialogue: 0,0:21:16.57,0:21:18.86,Default,,0,0,0,,{\an8}Neyse ki şu an hayatta, yani...
Dialogue: 0,0:21:20.49,0:21:24.41,Default,,0,0,0,,Tekrar sağ ol, Draken.\NBugün büyük bir felaketi önledik.
Dialogue: 0,0:21:25.08,0:21:26.08,Default,,0,0,0,,Öyle sayılır.
Dialogue: 0,0:21:28.33,0:21:29.66,Default,,0,0,0,,İyi bari.
Dialogue: 0,0:21:31.71,0:21:35.21,Default,,0,0,0,,Hadi, tüymemiz lazım.\NBizi burada birinin görmesi iyi olmaz.
Dialogue: 0,0:21:35.88,0:21:37.76,Default,,0,0,0,,Ha, doğru. Gidelim.
Dialogue: 0,0:21:39.84,0:21:41.59,Default,,0,0,0,,Draken, sen gelmiyor musun?
Dialogue: 0,0:21:41.68,0:21:42.97,Default,,0,0,0,,Takemichi.
Dialogue: 0,0:21:45.01,0:21:46.97,Default,,0,0,0,,Mikey'ye bir şey söyle benim için.
Dialogue: 0,0:21:47.06,0:21:48.43,Default,,0,0,0,,Ha?
Dialogue: 0,0:21:49.43,0:21:55.02,Default,,0,0,0,,De ki, artık onun için\Nendişelenmekten bıktım.
Dialogue: 0,0:21:55.11,0:21:56.44,Default,,0,0,0,,Şey...
Dialogue: 0,0:21:56.52,0:21:58.61,Default,,0,0,0,,Ben de bıktım ama kendin söylesene.
Dialogue: 0,0:22:05.32,0:22:06.87,Default,,0,0,0,,Olmaz.
Dialogue: 0,0:22:06.95,0:22:08.70,Default,,0,0,0,,Benim yolum buraya kadarmış.
Dialogue: 0,0:23:41.09,0:23:43.01,Default,,0,0,0,,MASAL İNTİKAMCILARI - MİNİ\N#7 "VEZİRLERİN İNTİKAMI!"
Dialogue: 0,0:23:44.67,0:23:46.72,Default,,0,0,0,,Daha ne kadar kazacağız ya?
Dialogue: 0,0:23:46.80,0:23:48.97,Default,,0,0,0,,Unuttun mu?\NO lambayı burada bulmuştuk.
Dialogue: 0,0:23:49.05,0:23:51.43,Default,,0,0,0,,Belki buralarda\Nbaşka hazineler de vardır.
Dialogue: 0,0:23:51.51,0:23:53.56,Default,,0,0,0,,Kazdıkça kazanç çıkacak yani!
Dialogue: 0,0:23:53.64,0:23:56.44,Default,,0,0,0,,Elimiz boş dönersek\Nbaşımıza ne geleceğini biliyorsun, değil mi?
Dialogue: 0,0:23:57.60,0:23:58.85,Default,,0,0,0,,Oha!
Dialogue: 0,0:23:58.94,0:24:00.69,Default,,0,0,0,,- Bayağı derinmiş.\N- Harbiden.
Dialogue: 0,0:24:00.77,0:24:02.11,Default,,0,0,0,,Önden buyur.
Dialogue: 0,0:24:05.19,0:24:06.70,Default,,0,0,0,,Acıdı lan!
Dialogue: 0,0:24:06.78,0:24:10.53,Default,,0,0,0,,Vay anasını! Harbiden hazine varmış burada!
Dialogue: 0,0:24:10.62,0:24:12.41,Default,,0,0,0,,Ne bulursanız kapın, tüyelim buradan.
Dialogue: 0,0:24:12.49,0:24:15.08,Default,,0,0,0,,Aynen, hadi koçum.\NŞunları bir güzel topla bize.
Dialogue: 0,0:24:15.16,0:24:17.62,Default,,0,0,0,,Oo, misafir beklemiyordum doğrusu.
Dialogue: 0,0:24:17.71,0:24:18.71,Default,,0,0,0,,{\pos(742,114)}YUTKUN!
Dialogue: 0,0:24:19.38,0:24:22.67,Default,,0,0,0,,Nasıl yardımcı olabilirim, beyler?\NYoksa beni soymaya mı geldiniz?
Dialogue: 0,0:24:22.75,0:24:23.92,Default,,0,0,0,,Yok, biz şey...
Dialogue: 0,0:24:25.09,0:24:27.01,Default,,0,0,0,,{\an8\fnArial\b1\c&HFFFFFF&\3c&H3361E6&\bord9\shad0\pos(1610,824)}DEVAM EDECEK
